      "actions": [
        {
          "action_name": "洗一次日常衣物",
          "steps": [
            "衣服放进滚筒，关舱门，听到锁定声。",
            "把左侧大旋钮转到最底，这是「棉织物 40 度」档，也是日常档。",
            "从标签向右三指宽，按开始键。机器会先锁门，大约 5 秒后才进水。"
          ],
          "source": "说明书第 6 页",
          "verified": true
        },
        {
          "action_name": "只脱水",
          "steps": [
            "转旋钮到最上面一档（脱水档）。",
            "按转速键两次，选择 1200 转。",
            "按开始键。"
          ],
          "source": "说明书第 8 页",
          "verified": true
        },
        {
          "action_name": "中途加衣服",
          "steps": [
            "按开始键暂停，等滚筒完全停稳、门锁「咔」声解除。",
            "开门加衣服，关门。",
            "再按一次开始键继续。注意：水位如果已经高过门沿，不要开门。"
          ],
          "source": "用户确认",
          "verified": true
        }
      ],
      "safety_notes": [
        "断电后再伸手进滚筒。",
        "羽绒服、带金属扣的衣物单独洗。",
        "舱门没锁上时机器不会进水，如果按了开始没反应，先检查门是否关严。"
      ],
