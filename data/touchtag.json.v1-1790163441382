      "actions": [
        {
          "action_name": "煮两杯米的白饭",
          "steps": [
            "内胆里放两杯米，加水到内胆内侧「2」刻度线。",
            "把内胆放回去，左右转一下让它落到位，盖上盖子。",
            "按凸起圆环，直到面板第一颗灯亮（精煮档）。",
            "按凸起三角形开始，面板会显示倒计时，大约 38 分钟。",
            "听到“叮”的一声并且保温灯亮，就是好了。"
          ],
          "source": "说明书第 4 页 + 用户确认",
          "verified": true
        },
        {
          "action_name": "取消当前程序",
          "steps": [
            "按凸起方块，程序停止并回到待机。注意：取消不等于断电，要彻底断电请直接拔插头。"
          ],
          "source": "用户确认",
          "verified": true
        },
        {
          "action_name": "预约早上七点煮好",
          "steps": [
            "先按凸起圆环选好煮饭档。",
            "按凸起三点进入预约，按几下就是几小时后开始，现在是晚上十点，按 9 下。",
            "按凸起三角形确认。面板上会出现一个小钟形灯。"
          ],
          "source": "说明书第 7 页",
          "verified": true
        }
      ],
      "safety_notes": [
        "内胆拿出来后才能加水，不要直接往机器里倒水。",
        "开盖时蒸汽很烫，脸和手离远一点。"
