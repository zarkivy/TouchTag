# TouchTag / 触界 —— 服务环境变量
# 复制到 /etc/touchtag.env，改完 systemctl restart touchtag 生效。
# systemd 单元里用的是 EnvironmentFile=-/etc/touchtag.env（前缀 - 表示文件不存在也能启动）。

# 监听地址与端口（nginx 反代到这里，不要直接暴露）
HOST=127.0.0.1
PORT=3000

# 数据目录（JSON 存储，注意备份）
TOUCHTAG_DATA_DIR=/var/lib/touchtag

# 打印在 NFC 标签上的短链前缀。
# 留空 = 跟随访问者使用的域名/IP，用 IP 访问和以后换域名都能自洽。
# 想固定成正式域名时取消注释：
# TOUCHTAG_BASE_URL=https://cerr.cc
# TOUCHTAG_BASE_URL=http://117.72.194.25

# ---- 物品助手的大模型（可选）----
# 不配置时使用内置的本地检索引擎：只引用物品档案里已经确认过的内容，
# 因此不会编造按钮，但也不能做跨物品的推理。三个变量都填才会启用。
# 任何 OpenAI 兼容的接口都可以，例如 DeepSeek、通义千问、Moonshot、vLLM。
#
# ⚠️ 推理模型（DeepSeek-V4.1-Flash 等）会先输出思考内容，且思考 token 计入 max_tokens。
#    预算给小了会「HTTP 200 但正文为空」，看起来成功其实没答。下面的默认值已按此调大。
#    EFFORT 控制推理强度：low 最快（语音场景要的是快），high/max 更慢但想得更深。
TOUCHTAG_LLM_BASE_URL=https://api.deepseek.com/v1
TOUCHTAG_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
TOUCHTAG_LLM_MODEL=deepseek-flash
TOUCHTAG_LLM_MAX_TOKENS=2400
TOUCHTAG_LLM_EFFORT=low
TOUCHTAG_LLM_TIMEOUT_MS=60000

# ---- 配置端视觉理解（可选，PRD F07 / 路演关键一步）----
# 用于「拍一张控制面板 → AI 给出按钮候选与触觉映射建议 → 人工确认」。
# 必须是 OpenAI 兼容的**多模态**接口（能收 image_url 的那种），三个变量都填才启用。
# DeepSeek-V4.1-Flash（模型 id：deepseek-flash）的文字和图片走同一个端点，可复用上面的配置。
# 未配置时：照片照常保存进档案，但候选只来自类别模板，页面会明确写「没有看图」。
#
# MAX_TOKENS 必须给足：实测 900 会 100% 失败，6000 在加了步骤起草后仍会被思考吃穿。
TOUCHTAG_VLM_BASE_URL=https://api.deepseek.com/v1
TOUCHTAG_VLM_API_KEY=sk-xxxxxxxxxxxxxxxx
TOUCHTAG_VLM_MODEL=deepseek-flash
TOUCHTAG_VLM_MAX_TOKENS=16000
TOUCHTAG_VLM_EFFORT=low
TOUCHTAG_VLM_TIMEOUT_MS=120000

# ---- 标签外形生成（可选，复用上面的模型）----
# 新增物品时按物品照片（没有照片则按名称与说明）画出这枚标签的剪影轮廓。
# 不单独配置时：有 VLM 配置就用 VLM 配置，否则用 LLM 配置；两者都没有则退回内置外形库，
# 页面会照实写明「外形生成暂不可用，本次使用内置外形」，不会假装是 AI 画的。
# 模型只负责「画」，几何由 lib/tactile.js 重新解析、校验坐标、等比铺满后重新序列化，
# 生成结果随物品入库（此后不再变化），因此同一件物品的标签手感始终一致。
# TOUCHTAG_SHAPE_MAX_TOKENS=16000  # 外形是短输出，但「想」的 token 也计入；给 8000 会被思考吃穿
# TOUCHTAG_SHAPE_EFFORT=low
# TOUCHTAG_SHAPE_TIMEOUT_MS=90000

# ---- 语音（默认开启，无需配置）----
# 神经网络语音（微软 Edge TTS 公开接口）不需要密钥；合成的 mp3 存在
# $TOUCHTAG_DATA_DIR/audio，命中缓存后打开页面即播（PRD F04 ≤3 秒）。
# TOUCHTAG_TTS=off              # 关掉服务器语音，改用浏览器自带合成
# TOUCHTAG_TTS_VOICE=xiaoxiao   # xiaoxiao（女声，温暖）/ yunxi（男声）/ yunyang（男声播报）
# TOUCHTAG_WARM_ON_BOOT=off     # 关掉启动时自动预热音频
